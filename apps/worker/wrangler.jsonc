{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "getyourresume-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_ENABLED": "true",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "ALLOWED_ORIGINS": "http://localhost:5188,http://127.0.0.1:5188,https://itspksharma.github.io",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1,https://itspksharma.github.io",
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "7211", "simple": { "limit": 5, "period": 60 } },
    { "name": "SERVICE_LIMITER", "namespace_id": "7212", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": false },
}
