# Public configuration only. Never put provider tokens or Turnstile secrets here.
# Paste your deployed Worker origin, without /api or a trailing slash.
# Leave empty until the Worker is deployed; standard resume tools still work.
VITE_API_URL=
# Paste the PUBLIC site key from your Cloudflare Turnstile widget.
VITE_TURNSTILE_SITE_KEY=
# Use /GetYourResume/ for a GitHub project page; / for local development.
VITE_BASE_PATH=/
# Restart npm run dev after editing .env.local.
# GitHub Pages builds use the matching GitHub Actions repository variables.
